# ==========================================================
# KAGADA 2026 — Environment Variables
# ==========================================================

# Resend API Key for sending transactional query emails (get one at https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Organizer Email to receive incoming queries (defaults to chairperson / registered owner)
CONTACT_NOTIFICATION_EMAIL=kagada.ieeeuvce@gmail.com

# Sender Email:
# Default free sandbox: "Kagada Queries <onboarding@resend.dev>"
# Custom verified domain: "Kagada Queries <queries@yourdomain.com>"
RESEND_FROM_EMAIL="Kagada Queries <queries@kagada2026.live>"

# AI Chat Assistant Keys (at least one recommended for dynamic replies):
# Groq API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter API Key (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
