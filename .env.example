# ==========================================================
# KAGADA 2026 — Environment Variables
# ==========================================================

# Resend API Key for sending transactional query emails (get one free at https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Organizer Email to receive incoming queries (defaults to chairperson / registered owner)
CONTACT_NOTIFICATION_EMAIL=kagada.ieeeuvce@gmail.com

# Sender Email:
# Default free sandbox: "Kagada Queries <onboarding@resend.dev>" (sends to registered owner)
# Custom verified domain: "Kagada Queries <queries@yourdomain.com>"
RESEND_FROM_EMAIL="Kagada Queries <queries@kagada2026.live>"

